@model AdminIndicatorConfigViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "شناسه‌ها و کد QR - " + Model.DataSourceName;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1">مدیریت شناسه‌ها و کدهای QR: @Model.DataSourceName</h1>
        <div class="small text-muted">تعداد شناسه‌های تولیدشده: <strong class="tabular-nums">@Model.GeneratedCount</strong></div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("PrintQrSheet", "Admin", new { id = Model.DataSourceId, mode = "A4" })" class="btn-hse btn-hse-secondary">چاپ برچسب A4</a>
        <a href="@Url.Action("PrintQrSheet", "Admin", new { id = Model.DataSourceId, mode = "Thermal" })" class="btn-hse btn-hse-secondary">چاپ لیبل حرارتی</a>
        <a href="@Url.Action("Index", "Admin")" class="btn-hse btn-hse-secondary">بازگشت</a>
    </div>
</div>

<div class="admin-grid">
    <div class="admin-col-5">
        <div class="hse-card">
            <h2 class="h6 fw-bold mb-3">الگوی ساخت شناسه یکتا (Indicator)</h2>

            @using (Html.BeginForm("SaveIndicatorConfig", "Admin", FormMethod.Post, new { @class = "hse-form-grid" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.DataSourceId)

                <div class="hse-field">
                    <label class="hse-label">ستون‌های تشکیل‌دهنده شناسه</label>
                    <div class="visibility-matrix">
                        @foreach (string col in Model.AvailableColumns)
                        {
                            bool selected = Model.SelectedIndicatorColumns.Contains(col);
                            <label class="visibility-row py-2" style="cursor: pointer;">
                                <span class="small fw-semibold">@col</span>
                                <input type="checkbox" name="SelectedIndicatorColumns" value="@col" class="form-check-input m-0" @(selected ? "checked" : "") />
                            </label>
                        }
                    </div>
                </div>

                <div class="hse-form-grid hse-form-grid--2col">
                    <div class="hse-field">
                        <label class="hse-label" for="IndicatorPrefix">پیشوند (اختیاری)</label>
                        @Html.TextBoxFor(m => m.IndicatorPrefix, new { @class = "hse-input ltr-isolate text-start", placeholder = "EXT" })
                    </div>
                    <div class="hse-field">
                        <label class="hse-label" for="IndicatorSeparator">جداکننده</label>
                        @Html.TextBoxFor(m => m.IndicatorSeparator, new { @class = "hse-input ltr-isolate text-start", placeholder = "-" })
                    </div>
                </div>

                <button type="submit" class="btn-hse btn-hse-primary btn-hse-block">ذخیره الگوی شناسه</button>
            }

            <hr class="my-3" />

            @using (Html.BeginForm("GenerateIndicators", "Admin", new { id = Model.DataSourceId }, FormMethod.Post, new { @class = "m-0" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-hse btn-hse-accent btn-hse-block">
                    تولید و بروزرسانی شناسه‌ها و کدهای QR
                </button>
            }
        </div>
    </div>

    <div class="admin-col-7">
        <div class="hse-card">
            <h2 class="h6 fw-bold mb-3">لیست شناسه‌های تولیدشده (@Model.Indicators.Count)</h2>
            @if (Model.Indicators.Count == 0)
            {
                <div class="text-muted small py-3">هنوز شناسه‌ای تولید نشده است. ابتدا الگو را ذخیره کرده و دکمه تولید را بزنید.</div>
            }
            else
            {
                <div class="rtl-table-wrap">
                    <table class="rtl-table">
                        <thead>
                            <tr>
                                <th>QR</th>
                                <th>شناسه (Indicator)</th>
                                <th>کلید تجهیز</th>
                                <th>لینک اسکن</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (AssetIndicatorItemViewModel item in Model.Indicators)
                            {
                                <tr>
                                    <td>
                                        <img src="data:image/png;base64,@item.QrPngBase64" alt="QR @item.Indicator" width="52" height="52" style="image-rendering: pixelated;" />
                                    </td>
                                    <td><span class="indicator-pill">@item.Indicator</span></td>
                                    <td class="ltr-isolate tabular-nums">@item.AssetKey</td>
                                    <td>
                                        <a href="@Url.Action("ScanByIndicator", "Scan", new { indicator = item.Indicator })" target="_blank" class="btn btn-sm btn-outline-primary">
                                            مشاهده صفحه اسکن
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
