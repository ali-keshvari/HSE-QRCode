@{
    ViewBag.Title = "جستجو و اسکن تجهیز";
}

<div class="hse-card hse-card-lg">
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="d-inline-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 48px; height: 48px; background: var(--color-primary-fixed); color: var(--color-on-primary-fixed);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
        </div>
        <div>
            <h1 class="h5 fw-bold mb-1">جستجوی دستی شناسه تجهیز</h1>
            <p class="text-muted small mb-0">در صورت آسیب‌دیدگی برچسب QR، کد شناسه تجهیز را وارد کنید.</p>
        </div>
    </div>

    @if (TempData["LookupError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
            @TempData["LookupError"]
        </div>
    }

    <form action="@Url.RouteUrl("Lookup")" method="get" class="qr-lookup-bar js-indicator-lookup-form" data-lookup-json-url="@Url.Action("LookupJson", "Scan")">
        <div class="qr-lookup-bar__input-wrap">
            <input type="text"
                   name="indicator"
                   class="qr-lookup-bar__input js-indicator-lookup-input"
                   placeholder="مثال: EXT-1042"
                   autocomplete="off"
                   required />
        </div>
        <button type="submit" class="btn-hse btn-hse-primary">جستجو</button>
    </form>

    <div class="js-lookup-feedback mt-3 d-none"></div>
</div>

<div class="hse-card">
    <h2 class="h6 fw-bold mb-2">راهنمای سریع</h2>
    <ul class="small text-muted mb-0 ps-3 d-flex flex-column gap-1">
        <li>با اسکن برچسب QR روی هر تجهیز، صفحه وضعیت عمومی آن باز می‌شود.</li>
        <li>اگر برچسب مخدوش است، کد چاپ‌شده زیر QR را در کادر بالا وارد کنید.</li>
        <li>پرسنل مجاز می‌توانند پس از ورود، سوابق کامل و فرم ثبت بازرسی جدید را مشاهده کنند.</li>
    </ul>
</div>
